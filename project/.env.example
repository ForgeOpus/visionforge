# =====================================================
# BACKEND ENVIRONMENT VARIABLES (Django)
# =====================================================
# This file contains SERVER-SIDE secrets and configuration.
# These variables are NEVER exposed to the browser.
# Used by: Django backend, Firebase Admin SDK, Oracle DB
# =====================================================

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Deployment Environment
# Set to "DEV" or "LOCAL" to use server-side API keys (for local development)
# Set to "PROD" or leave empty to require users to provide their own keys (for remote deployment)
# Default: PROD (users bring their own keys)
ENVIRONMENT=DEV

# AI Provider Configuration
# Choose which AI provider to use: 'gemini' or 'claude'
AI_PROVIDER=gemini

# Gemini AI Configuration (DEV/LOCAL mode only)
# Get your API key from: https://aistudio.google.com/app/apikey
# Only required when ENVIRONMENT=DEV or ENVIRONMENT=LOCAL
GEMINI_API_KEY=your-gemini-api-key-here

# Claude AI Configuration (DEV/LOCAL mode only)
# Get your API key from: https://console.anthropic.com/
# Only required when ENVIRONMENT=DEV or ENVIRONMENT=LOCAL
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Database (optional, defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Service Account (REQUIRED for backend token verification)
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# Oracle Cloud Database (for authentication)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=

# GitHub OAuth (configured in Firebase Console)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =====================================================
# OBSERVABILITY & METRICS CONFIGURATION
# =====================================================

# OpenTelemetry Service Configuration
OTEL_SERVICE_NAME=visionforge-backend
OTEL_SERVICE_VERSION=1.0.0

# Enable Prometheus metrics exporter (default: True)
# Exposes metrics on port 9090
OTEL_ENABLE_PROMETHEUS=True

# Enable OTLP exporter for sending metrics to collector (default: False)
# Set to True if using OpenTelemetry Collector
OTEL_ENABLE_OTLP=False

# OTLP Collector endpoint (only needed if OTLP is enabled)
# Example: localhost:4317 for gRPC
OTEL_EXPORTER_OTLP_ENDPOINT=
