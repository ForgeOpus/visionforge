              f"Val Acc: {val_accuracy.result()*100:.2f}%")
{% else %}
              f"Val Loss: {val_loss_avg.result():.4f}")
{% endif %}
{% endif %}

        # Save best model
        if val_loss_avg.result() < best_val_loss:
